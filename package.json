{
  "name": "userlistserver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch-path=src src/index.ts",
    "start": "node src/index.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "typecheck": "npm run codegen:check && tsc --noEmit",
    "test": "vitest run",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "iron-session": "^9.1.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
